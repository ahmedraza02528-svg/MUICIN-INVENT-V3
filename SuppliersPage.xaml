<Page x:Class="MUICIN_INVENT_V3.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SuppliersPage"
      Background="#F5F7FB">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Suppliers"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Manage suppliers, purchases and outstanding balances"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#6B7280"/>
            </StackPanel>

          <Button Grid.Column="1"
        Content="+  Add Supplier"
        Width="145"
        Height="42"
        Background="#2563EB"
        Foreground="White"
        BorderThickness="0"
        FontWeight="SemiBold"
        Cursor="Hand"
        Click="AddSupplier_Click"/>
        </Grid>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18">
				<StackPanel>
					<TextBlock Text="TOTAL SUPPLIERS"
							   Foreground="#6B7280"
							   FontSize="12"/>

					<TextBlock x:Name="TotalSuppliersText"
							   Text="0"
							   Margin="0,8,0,0"
							   FontSize="25"
							   FontWeight="Bold"/>
				</StackPanel>
			</Border>

			<Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18">
				<StackPanel>
					<TextBlock Text="ACTIVE SUPPLIERS"
							   Foreground="#6B7280"
							   FontSize="12"/>

					<TextBlock x:Name="ActiveSuppliersText"
							   Text="0"
							   Margin="0,8,0,0"
							   FontSize="25"
							   FontWeight="Bold"/>
				</StackPanel>
			</Border>

            <Border Grid.Column="4"
                    Background="White"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="TOTAL PURCHASES"
                               Foreground="#6B7280"
                               FontSize="12"/>
                    <TextBlock x:Name="TotalPurchasesText" Text="Rs. 0"
                               Margin="0,8,0,0"
                               FontSize="25"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6"
                    Background="White"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="OUTSTANDING PAYABLE"
                               Foreground="#6B7280"
                               FontSize="12"/>
                    <TextBlock x:Name="OutstandingPayableText" Text="Rs. 0"
                               Margin="0,8,0,0"
                               FontSize="25"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SEARCH -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                Padding="15">

            <TextBox x:Name="SearchTextBox"
                     Height="38"
                     Padding="12,7"
                     FontSize="14"
                     Text=""
                     Foreground="#6B7280"
                     TextChanged="SearchTextBox_TextChanged"
                     />
        </Border>

        <!-- SUPPLIER TABLE -->
        <Border Grid.Row="6"
                Background="White"
                CornerRadius="8"
                Padding="15">

			<DataGrid x:Name="SuppliersDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White"
                      RowHeight="42">

				<DataGrid.Columns>

					<DataGridTextColumn Header="Supplier ID"
										Binding="{Binding SupplierId}"
										Width="100"/>

					<DataGridTextColumn Header="Supplier Name"
										Binding="{Binding SupplierName}"
										Width="*"/>

					<DataGridTextColumn Header="Contact Person"
										Binding="{Binding ContactPerson}"
										Width="150"/>

					<DataGridTextColumn Header="Phone"
										Binding="{Binding Phone}"
										Width="130"/>

					<DataGridTextColumn Header="City"
										Binding="{Binding City}"
										Width="110"/>

					<DataGridTextColumn Header="Total Purchases"
										Binding="{Binding TotalPurchases}"
										Width="140"/>

					<DataGridTextColumn Header="Balance"
										Binding="{Binding Balance}"
										Width="120"/>

					<DataGridTextColumn Header="Status"
										Binding="{Binding Status}"
										Width="100"/>

                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="View" Margin="2" Padding="6,2" Click="ViewSupplier_Click"/>
                                    <Button Content="Edit" Margin="2" Padding="6,2" Click="EditSupplier_Click"/>
                                    <Button Content="Delete" Margin="2" Padding="6,2" Click="DeleteSupplier_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

				</DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</Page>