<Page x:Class="MUICIN_INVENT_V3.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="#F5F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Dashboard"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#172033"/>

                    <TextBlock Text="Overview and quick actions"
                               FontSize="13"
                               Foreground="#7B8495"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- SUMMARY CARDS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOTAL PRODUCTS" Foreground="#7B8495" FontSize="11"/>
                        <TextBlock Text="0" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOTAL STOCK" Foreground="#7B8495" FontSize="11"/>
                        <TextBlock Text="0" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="LOW STOCK" Foreground="#7B8495" FontSize="11"/>
                        <TextBlock Text="0" FontSize="24" FontWeight="Bold" Foreground="#E59A00" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Background="White" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="RECEIVABLE" Foreground="#7B8495" FontSize="11"/>
                        <TextBlock Text="Rs. 0" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- QUICK ACTIONS -->
            <StackPanel Grid.Row="4" Orientation="Vertical">
                <Border Style="{StaticResource Card}" Background="White" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButton}" Content="+  New Sale (POS)" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ActionButton}" Content="+  Add Product" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ActionButton}" Content="+  New Purchase"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>