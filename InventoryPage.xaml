<Page x:Class="MUICIN_INVENT_V3.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Inventory"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#172033"/>

                    <TextBlock Text="Manage products, stock, pricing and inventory."
                               FontSize="13"
                               Foreground="#7B8495"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button Content="+ Add Product"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="135"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="AddProduct_Click"/>
            </Grid>

            <!-- SUMMARY CARDS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOTAL PRODUCTS"
                                   Foreground="#7B8495"
                                   FontSize="11"/>
                        <TextBlock x:Name="TotalProductsText" Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOTAL STOCK"
                                   Foreground="#7B8495"
                                   FontSize="11"/>
                        <TextBlock x:Name="TotalStockText" Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="LOW STOCK"
                                   Foreground="#7B8495"
                                   FontSize="11"/>
                        <TextBlock x:Name="LowStockText" Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#E59A00"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6"
                        Background="White"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="OUT OF STOCK"
                                   Foreground="#7B8495"
                                   FontSize="11"/>
                        <TextBlock x:Name="ExpiringSoonText" Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#DC3545"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PRODUCT AREA -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <!-- SEARCH / FILTER -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox" Grid.Column="0"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 Text=""
                                 TextChanged="SearchTextBox_TextChanged"
                                 />

                        <ComboBox x:Name="LocationFilterComboBox" Grid.Column="2"
                                  Height="38"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Inventories"/>
                            <ComboBoxItem Content="Main Warehouse"/>
                            <ComboBoxItem Content="Office Stock"/>
                            <ComboBoxItem Content="Online Stock"/>
                        </ComboBox>

                        <Button Grid.Column="4"
                                Content="+ New Inventory"
                                Background="#172033"
                                Foreground="White"
                                BorderThickness="0"/>
                    </Grid>

                    <!-- COLUMN HEADERS -->
                    <Border Background="#F3F5F9"
                            CornerRadius="5"
                            Padding="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="IMAGE" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="SKU" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="PRODUCT" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="USE" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="STOCK" FontWeight="Bold"/>
                            <TextBlock Grid.Column="5" Text="PRICE" FontWeight="Bold"/>
                            <TextBlock Grid.Column="6" Text="DISCOUNT" FontWeight="Bold"/>
                            <TextBlock Grid.Column="7" Text="QTY" FontWeight="Bold"/>
                            <TextBlock Grid.Column="8" Text="TOTAL" FontWeight="Bold"/>
                            <TextBlock Grid.Column="9" Text="ACTION" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- SAMPLE PRODUCT -->
                    <Border BorderBrush="#E7EAF0"
                            BorderThickness="0,0,0,1"
                            Padding="10,15">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="45"
                                    Height="45"
                                    Background="#EEF2F7"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="IMG"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#8993A4"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="1472"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Vitamin C Go &amp; Glow Facial Kit"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Facial Care"
                                           Foreground="#8993A4"
                                           FontSize="11"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3"
                                       Text="Skin brightening"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="4"
                                       Text="120"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="5"
                                       Text="Rs. 2,000"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="6"
                                       Text="3%"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="7"
                                       Text="1"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="8"
                                       Text="Rs. 1,940"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="9"
                                    Content="Edit"
                                    Width="60"
                                    Height="30"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>