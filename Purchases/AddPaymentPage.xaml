<Page x:Class="MUICIN_INVENT_V3.Purchases.AddPaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB">

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Add Payment" FontSize="20" FontWeight="Bold"/>
            <Border Background="White" Padding="12" CornerRadius="8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Amount" FontWeight="SemiBold"/>
                    <TextBox x:Name="AmountTextBox" Height="34" Margin="0,6,0,0" Text="0"/>

                    <TextBlock Text="Payment Method" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ComboBox x:Name="MethodComboBox" Height="34" Margin="0,6,0,0">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Bank"/>
                        <ComboBoxItem Content="Credit"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <TextBlock Text="Reference" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBox x:Name="ReferenceTextBox" Height="34" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="120" Click="Cancel_Click"/>
                <Button Content="Add Payment" Width="140" Margin="8,0,0,0" Background="#1677E8" Foreground="White" Click="AddPayment_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
