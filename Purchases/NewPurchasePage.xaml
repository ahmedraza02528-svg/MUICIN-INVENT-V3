<Page x:Class="MUICIN_INVENT_V3.Purchases.NewPurchasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="New Purchase" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Create and post supplier purchases (Draft/Posted)." FontSize="13" Foreground="#6B7280"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Purchase Number" FontWeight="SemiBold"/>
                        <TextBox x:Name="PurchaseNumberTextBox" IsReadOnly="True" Height="34" Margin="0,7,0,0"/>

                        <TextBlock Text="Purchase Date" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <DatePicker x:Name="PurchaseDatePicker" Height="34" Margin="0,7,0,0"/>

                        <TextBlock Text="Supplier" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <ComboBox x:Name="SupplierComboBox" Height="34" DisplayMemberPath="SupplierName"/>

                        <TextBlock Text="Supplier Invoice No." FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBox x:Name="SupplierInvoiceTextBox" Height="34" Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Receiving Location" FontWeight="SemiBold"/>
                        <TextBox x:Name="LocationTextBox" Height="34" Margin="0,7,0,0"/>

                        <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBox x:Name="NotesTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,12"/>

                <TextBlock Text="Purchase Lines" FontWeight="SemiBold"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ProductSelector" Grid.Column="0" Height="32" DisplayMemberPath="ProductName"/>
                    <TextBox x:Name="QtyTextBox" Grid.Column="1" Height="32" Margin="8,0,0,0" Text="1"/>
                    <TextBox x:Name="CostTextBox" Grid.Column="2" Height="32" Margin="8,0,0,0" Text="0"/>
                    <TextBox x:Name="LineDiscountTextBox" Grid.Column="3" Height="32" Margin="8,0,0,0" Text="0"/>
                    <Button Content="Add Item" Grid.Column="4" Width="110" Margin="8,0,0,0" Click="AddLine_Click"/>
                </Grid>

                <DataGrid x:Name="LinesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,0" Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}"/>
                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Subtotal" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtotalText" Text="Rs. 0.00"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Grand Total" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GrandTotalText" Text="Rs. 0.00"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save Draft" Width="120" Margin="0,0,8,0" Click="SaveDraft_Click"/>
            <Button Content="Post Purchase" Width="140" Background="#1677E8" Foreground="White" Click="PostPurchase_Click"/>
        </StackPanel>
    </Grid>
</Page>
