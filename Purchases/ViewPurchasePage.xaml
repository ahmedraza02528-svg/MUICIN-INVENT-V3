<Page x:Class="MUICIN_INVENT_V3.Purchases.ViewPurchasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Purchase Details" FontSize="22" FontWeight="Bold"/>
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="PurchaseNumberText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SupplierText"/>
                    <TextBlock x:Name="DateText"/>
                    <TextBlock x:Name="TotalsText"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                    <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Back" Width="120" Click="Back_Click"/>
                <Button Content="Add Payment" Width="120" Margin="8,0,0,0" Click="AddPayment_Click"/>
                <Button Content="Return Item" Width="120" Margin="8,0,0,0" Click="Return_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
