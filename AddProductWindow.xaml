<Window x:Class="MUICIN_INVENT_V3.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Product"
        Height="720"
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Add / Edit Product"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Enter product information and stock details"
                       Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#6B7280"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Product Name -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Product Name *" FontWeight="SemiBold"/>
                        <TextBox x:Name="ProductNameTextBox" Height="38" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>

                    <!-- SKU -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="SKU *" FontWeight="SemiBold"/>
                        <TextBox x:Name="SKUTextBox" Height="38" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>

                    <!-- Barcode -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Barcode" FontWeight="SemiBold"/>
                        <TextBox x:Name="BarcodeTextBox" Height="38" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Category" FontWeight="SemiBold"/>
                        <TextBox x:Name="CategoryTextBox" Height="38" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>

                    <!-- Brand -->
                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Brand" FontWeight="SemiBold"/>
                        <TextBox x:Name="BrandTextBox" Height="38" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>

                    <!-- Selling Price -->
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Selling Price (Rs.)" FontWeight="SemiBold"/>
                        <TextBox x:Name="SellingPriceTextBox" Height="38" Margin="0,7,0,0" Padding="10,7" Text="0"/>
                    </StackPanel>

                    <!-- Cost Price -->
                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Cost Price (Rs.)" FontWeight="SemiBold"/>
                        <TextBox x:Name="CostPriceTextBox" Height="38" Margin="0,7,0,0" Padding="10,7" Text="0"/>
                    </StackPanel>

                    <!-- Discount -->
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Discount %" FontWeight="SemiBold"/>
                        <TextBox x:Name="DiscountTextBox" Height="38" Margin="0,7,0,0" Padding="10,7" Text="0"/>
                    </StackPanel>

                    <!-- Opening Stock -->
                    <StackPanel Grid.Row="8" Grid.Column="0">
                        <TextBlock Text="Opening Stock" FontWeight="SemiBold"/>
                        <TextBox x:Name="OpeningStockTextBox" Height="38" Margin="0,7,0,0" Padding="10,7" Text="0"/>
                    </StackPanel>

                    <!-- Min Stock Level -->
                    <StackPanel Grid.Row="8" Grid.Column="2">
                        <TextBlock Text="Minimum Stock Level" FontWeight="SemiBold"/>
                        <TextBox x:Name="MinStockTextBox" Height="38" Margin="0,7,0,0" Padding="10,7" Text="0"/>
                    </StackPanel>

                    <!-- Location -->
                    <StackPanel Grid.Row="10" Grid.Column="0">
                        <TextBlock Text="Location" FontWeight="SemiBold"/>
                        <TextBox x:Name="LocationTextBox" Height="38" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>

                    <!-- Batch -->
                    <StackPanel Grid.Row="10" Grid.Column="2">
                        <TextBlock Text="Batch / Lot Number" FontWeight="SemiBold"/>
                        <TextBox x:Name="BatchTextBox" Height="38" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>

                    <!-- Manufacturing / Expiry -->
                    <StackPanel Grid.Row="12" Grid.Column="0">
                        <TextBlock Text="Manufacturing Date" FontWeight="SemiBold"/>
                        <DatePicker x:Name="ManufacturingDatePicker" Height="34" Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="12" Grid.Column="2">
                        <TextBlock Text="Expiry Date" FontWeight="SemiBold"/>
                        <DatePicker x:Name="ExpiryDatePicker" Height="34" Margin="0,7,0,0"/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Description" FontWeight="SemiBold"/>
                        <TextBox x:Name="DescriptionTextBox" Height="80" Margin="0,7,0,0" Padding="10" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Image upload -->
                    <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="UploadImageButton" Content="Upload Image" Click="UploadImageButton_Click" Width="120" Height="36"/>
                        <Image x:Name="ProductImagePreview" Width="80" Height="80" Margin="12,0" Stretch="Uniform"/>
                        <StackPanel Margin="18,0,0,0">
                            <TextBlock Text="Status" FontWeight="SemiBold"/>
                            <ComboBox x:Name="StatusComboBox" Width="140" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Expiring Soon" />
                                <ComboBoxItem Content="Expired" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="110" Height="42" Margin="0,0,12,0" Background="#E5E7EB" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="Save Product" Width="145" Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="SaveProduct_Click"/>
        </StackPanel>

    </Grid>
</Window>